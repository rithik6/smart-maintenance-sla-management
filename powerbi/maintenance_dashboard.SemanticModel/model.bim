{
  "name": "Model",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Equipment",
        "columns": [
          {
            "name": "Equipment ID",
            "dataType": "int64",
            "sourceColumn": "Equipment ID",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Equipment Name",
            "dataType": "string",
            "sourceColumn": "Equipment Name",
            "summarizeBy": "none"
          },
          {
            "name": "Production Line",
            "dataType": "string",
            "sourceColumn": "Production Line",
            "summarizeBy": "none"
          },
          {
            "name": "Location",
            "dataType": "string",
            "sourceColumn": "Location",
            "summarizeBy": "none"
          },
          {
            "name": "Asset Status",
            "dataType": "string",
            "sourceColumn": "Asset Status",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Equipment",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Maintenance Source\"{[Schema = \"maintenance\", Item = \"equipment\"]}[Data],",
                "    Typed = Table.TransformColumnTypes(Source, {{\"equipment_id\", Int64.Type}, {\"equipment_name\", type text}, {\"production_line\", type text}, {\"location\", type text}, {\"status\", type text}}),",
                "    Renamed = Table.RenameColumns(Typed, {{\"equipment_id\", \"Equipment ID\"}, {\"equipment_name\", \"Equipment Name\"}, {\"production_line\", \"Production Line\"}, {\"location\", \"Location\"}, {\"status\", \"Asset Status\"}})",
                "in",
                "    Renamed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Technicians",
        "columns": [
          {
            "name": "Technician ID",
            "dataType": "int64",
            "sourceColumn": "Technician ID",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Technician Name",
            "dataType": "string",
            "sourceColumn": "Technician Name",
            "summarizeBy": "none"
          },
          {
            "name": "Specialization",
            "dataType": "string",
            "sourceColumn": "Specialization",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Technicians",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Maintenance Source\"{[Schema = \"maintenance\", Item = \"technicians\"]}[Data],",
                "    Typed = Table.TransformColumnTypes(Source, {{\"technician_id\", Int64.Type}, {\"technician_name\", type text}, {\"specialization\", type text}}),",
                "    Renamed = Table.RenameColumns(Typed, {{\"technician_id\", \"Technician ID\"}, {\"technician_name\", \"Technician Name\"}, {\"specialization\", \"Specialization\"}})",
                "in",
                "    Renamed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Report Snapshot",
        "columns": [
          {
            "name": "Period Start",
            "dataType": "dateTime",
            "sourceColumn": "Period Start",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy HH:mm"
          },
          {
            "name": "Snapshot At",
            "dataType": "dateTime",
            "sourceColumn": "Snapshot At",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy HH:mm"
          }
        ],
        "partitions": [
          {
            "name": "Report Snapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Maintenance Source\"{[Schema = \"maintenance\", Item = \"report_snapshot\"]}[Data],",
                "    Typed = Table.TransformColumnTypes(Source, {{\"period_start_at\", type datetime}, {\"snapshot_at\", type datetime}}),",
                "    Renamed = Table.RenameColumns(Typed, {{\"period_start_at\", \"Period Start\"}, {\"snapshot_at\", \"Snapshot At\"}})",
                "in",
                "    Renamed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "isHidden": true
      },
      {
        "name": "Tickets",
        "columns": [
          {
            "name": "Ticket ID",
            "dataType": "int64",
            "sourceColumn": "Ticket ID",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Equipment ID",
            "dataType": "int64",
            "sourceColumn": "Equipment ID",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Technician ID",
            "dataType": "int64",
            "sourceColumn": "Technician ID",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Issue Category",
            "dataType": "string",
            "sourceColumn": "Issue Category",
            "summarizeBy": "none"
          },
          {
            "name": "Description",
            "dataType": "string",
            "sourceColumn": "Description",
            "summarizeBy": "none"
          },
          {
            "name": "Priority",
            "dataType": "string",
            "sourceColumn": "Priority",
            "summarizeBy": "none",
            "sortByColumn": "Priority Order"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status",
            "summarizeBy": "none",
            "sortByColumn": "Status Order"
          },
          {
            "name": "Created At",
            "dataType": "dateTime",
            "sourceColumn": "Created At",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy HH:mm"
          },
          {
            "name": "First Response At",
            "dataType": "dateTime",
            "sourceColumn": "First Response At",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy HH:mm"
          },
          {
            "name": "Resolved At",
            "dataType": "dateTime",
            "sourceColumn": "Resolved At",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy HH:mm"
          },
          {
            "name": "SLA Target Hours",
            "dataType": "int64",
            "sourceColumn": "SLA Target Hours",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Estimated Downtime Hours",
            "dataType": "decimal",
            "sourceColumn": "Estimated Downtime Hours",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "Created Date",
            "dataType": "dateTime",
            "sourceColumn": "Created Date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy",
            "isHidden": true
          },
          {
            "name": "SLA Deadline",
            "dataType": "dateTime",
            "sourceColumn": "SLA Deadline",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy HH:mm"
          },
          {
            "name": "Repair Hours",
            "dataType": "double",
            "sourceColumn": "Repair Hours",
            "summarizeBy": "none",
            "formatString": "0.00",
            "isHidden": true
          },
          {
            "name": "Priority Order",
            "dataType": "int64",
            "sourceColumn": "Priority Order",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Status Order",
            "dataType": "int64",
            "sourceColumn": "Status Order",
            "summarizeBy": "none",
            "formatString": "0",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Tickets",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Maintenance Source\",",
                "    Raw = Source{[Schema = \"maintenance\", Item = \"maintenance_tickets\"]}[Data],",
                "    Scope = Source{[Schema = \"maintenance\", Item = \"report_snapshot\"]}[Data]{0},",
                "    Typed = Table.TransformColumnTypes(Raw, {{\"ticket_id\", Int64.Type}, {\"equipment_id\", Int64.Type}, {\"technician_id\", Int64.Type}, {\"issue_category\", type text}, {\"description\", type text}, {\"priority\", type text}, {\"status\", type text}, {\"created_at\", type datetime}, {\"first_response_at\", type datetime}, {\"resolved_at\", type datetime}, {\"sla_target_hours\", Int64.Type}, {\"estimated_downtime_hours\", Currency.Type}}, \"en-US\"),",
                "    InPeriod = Table.SelectRows(Typed, each [created_at] >= Scope[period_start_at] and [created_at] < Scope[snapshot_at]),",
                "    Renamed = Table.RenameColumns(InPeriod, {{\"ticket_id\", \"Ticket ID\"}, {\"equipment_id\", \"Equipment ID\"}, {\"technician_id\", \"Technician ID\"}, {\"issue_category\", \"Issue Category\"}, {\"description\", \"Description\"}, {\"priority\", \"Priority\"}, {\"status\", \"Status\"}, {\"created_at\", \"Created At\"}, {\"first_response_at\", \"First Response At\"}, {\"resolved_at\", \"Resolved At\"}, {\"sla_target_hours\", \"SLA Target Hours\"}, {\"estimated_downtime_hours\", \"Estimated Downtime Hours\"}}),",
                "    CreatedDate = Table.AddColumn(Renamed, \"Created Date\", each Date.From([Created At]), type date),",
                "    Deadline = Table.AddColumn(CreatedDate, \"SLA Deadline\", each [Created At] + #duration(0, 1, 0, 0) * [SLA Target Hours], type datetime),",
                "    RepairHours = Table.AddColumn(Deadline, \"Repair Hours\", each if [Resolved At] = null then null else Duration.TotalHours([Resolved At] - [First Response At]), type nullable number),",
                "    PriorityOrder = Table.AddColumn(RepairHours, \"Priority Order\", each List.PositionOf({\"Critical\", \"High\", \"Medium\", \"Low\"}, [Priority]) + 1, Int64.Type),",
                "    StatusOrder = Table.AddColumn(PriorityOrder, \"Status Order\", each List.PositionOf({\"Open\", \"In Progress\", \"Resolved\"}, [Status]) + 1, Int64.Type)",
                "in",
                "    StatusOrder"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "measures": [
          {
            "name": "Total Tickets",
            "expression": [
              "COALESCE ( COUNTROWS ( Tickets ), 0 )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Open Tickets",
            "expression": [
              "CALCULATE (",
              "    [Total Tickets],",
              "    KEEPFILTERS ( Tickets[Status] IN { \"Open\", \"In Progress\" } )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Overdue Tickets",
            "expression": [
              "VAR SnapshotAt = SELECTEDVALUE ( 'Report Snapshot'[Snapshot At] )",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( SnapshotAt ),",
              "        CALCULATE ( [Open Tickets], KEEPFILTERS ( Tickets[SLA Deadline] < SnapshotAt ) )",
              "    )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Resolved Tickets",
            "expression": [
              "CALCULATE ( [Total Tickets], KEEPFILTERS ( Tickets[Status] = \"Resolved\" ) )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Resolved Within SLA",
            "expression": [
              "COALESCE (",
              "    COUNTROWS (",
              "        FILTER ( Tickets, Tickets[Status] = \"Resolved\" && Tickets[Resolved At] <= Tickets[SLA Deadline] )",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "SLA Compliance %",
            "expression": [
              "DIVIDE ( [Resolved Within SLA], [Resolved Tickets] )"
            ],
            "formatString": "0.00%"
          },
          {
            "name": "MTTR Hours",
            "expression": [
              "CALCULATE ( AVERAGE ( Tickets[Repair Hours] ), KEEPFILTERS ( Tickets[Status] = \"Resolved\" ) )"
            ],
            "formatString": "0.00\" h\""
          },
          {
            "name": "Hours Overdue",
            "expression": [
              "VAR SnapshotAt = SELECTEDVALUE ( 'Report Snapshot'[Snapshot At] )",
              "VAR Deadline = SELECTEDVALUE ( Tickets[SLA Deadline] )",
              "RETURN",
              "    IF (",
              "        HASONEVALUE ( Tickets[Ticket ID] ) && [Overdue Tickets] = 1,",
              "        DIVIDE ( DATEDIFF ( Deadline, SnapshotAt, SECOND ), 3600 )",
              "    )"
            ],
            "formatString": "0.00\" h\""
          },
          {
            "name": "Repeat Incident Tickets",
            "expression": [
              "VAR AssetID = SELECTEDVALUE ( Equipment[Equipment ID] )",
              "VAR TicketCount = [Total Tickets]",
              "VAR HigherRankedAssets =",
              "    FILTER (",
              "        ALLSELECTED ( Equipment ),",
              "        VAR OtherCount = [Total Tickets]",
              "        RETURN OtherCount > TicketCount || ( OtherCount = TicketCount && Equipment[Equipment ID] < AssetID )",
              "    )",
              "RETURN",
              "    IF ( NOT ISBLANK ( AssetID ) && TicketCount >= 2 && COUNTROWS ( HigherRankedAssets ) < 10, TicketCount )"
            ],
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Calendar",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "Month Start",
            "dataType": "dateTime",
            "sourceColumn": "Month Start",
            "summarizeBy": "none",
            "formatString": "MMM yyyy",
            "isHidden": true
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "sortByColumn": "Month Start"
          }
        ],
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Scope = #\"Report Snapshot\"{0},",
                "    StartDate = Date.From(Scope[Period Start]),",
                "    EndDate = Date.From(Scope[Snapshot At]),",
                "    Days = List.Dates(StartDate, Duration.Days(EndDate - StartDate), #duration(1, 0, 0, 0)),",
                "    Dates = Table.FromColumns({Days}, type table [Date = date]),",
                "    MonthStart = Table.AddColumn(Dates, \"Month Start\", each Date.StartOfMonth([Date]), type date),",
                "    Month = Table.AddColumn(MonthStart, \"Month\", each Date.ToText([Date], [Format = \"MMM yyyy\", Culture = \"en-US\"]), type text)",
                "in",
                "    Month"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "94025795-1f3d-5704-82d5-1d2c6c4bd235",
        "fromTable": "Tickets",
        "fromColumn": "Equipment ID",
        "toTable": "Equipment",
        "toColumn": "Equipment ID",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "f3525b94-56d7-56ff-98d6-9a81d7991e07",
        "fromTable": "Tickets",
        "fromColumn": "Technician ID",
        "toTable": "Technicians",
        "toColumn": "Technician ID",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "3bf23663-5116-5f33-8b2c-6ebff9b1f45c",
        "fromTable": "Tickets",
        "fromColumn": "Created Date",
        "toTable": "Calendar",
        "toColumn": "Date",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "expressions": [
      {
        "name": "Data Source",
        "kind": "m",
        "expression": "\"Bundled Snapshot\" meta [IsParameterQuery = true, Type = \"Text\", IsParameterQueryRequired = true, List = {\"Bundled Snapshot\", \"PostgreSQL\"}, DefaultValue = \"Bundled Snapshot\"]"
      },
      {
        "name": "PostgreSQL Server",
        "kind": "m",
        "expression": "\"localhost:5432\" meta [IsParameterQuery = true, Type = \"Text\", IsParameterQueryRequired = true]"
      },
      {
        "name": "PostgreSQL Database",
        "kind": "m",
        "expression": "\"smart_maintenance_demo\" meta [IsParameterQuery = true, Type = \"Text\", IsParameterQueryRequired = true]"
      },
      {
        "name": "Maintenance Source",
        "kind": "m",
        "expression": [
          "if #\"Data Source\" = \"PostgreSQL\" then",
          "    PostgreSQL.Database(#\"PostgreSQL Server\", #\"PostgreSQL Database\", [CreateNavigationProperties = false])",
          "else",
          "    let",
          "        ParseCsv = (value as text) as table => Table.PromoteHeaders(Csv.Document(Binary.Decompress(Binary.FromText(value, BinaryEncoding.Base64), Compression.Deflate), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),",
          "        Assets = ParseCsv(\"\"),",
          "        Staff = ParseCsv(\"VdC7DsIwDIXhPU/BA3hoeu+MGLuVGUUhEpZMglpPPD1WB2KPv74zHU7xlTFiyA98AtfK4Z3g+CQJwm9gLNl52P6DS+NhlQqSgVxrqNXUGeo09YZ6uFGKvJ80GBo0jYZGTZOhCa4l817ocLOBucJiYKngGy1Sd0ZCxiRkjpBSZI6QqvQD\"),",
          "        RawTickets = ParseCsv(\"\"),",
          "        TicketData = Table.ReplaceValue(RawTickets, \"\", null, Replacer.ReplaceValue, {\"technician_id\", \"first_response_at\", \"resolved_at\"}),",
          "        Snapshot = #table(type table [period_start_at = datetime, snapshot_at = datetime], {{#datetime(2026, 1, 1, 0, 0, 0), #datetime(2026, 7, 1, 0, 0, 0)}}),",
          "        Navigation = #table(type table [Schema = text, Item = text, Data = table], {{\"maintenance\", \"equipment\", Assets}, {\"maintenance\", \"technicians\", Staff}, {\"maintenance\", \"maintenance_tickets\", TicketData}, {\"maintenance\", \"report_snapshot\", Snapshot}})",
          "    in",
          "        Navigation"
        ]
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Data Source\", \"PostgreSQL Server\", \"PostgreSQL Database\", \"Maintenance Source\", \"Equipment\", \"Technicians\", \"Report Snapshot\", \"Tickets\", \"Calendar\"]"
      }
    ]
  }
}
